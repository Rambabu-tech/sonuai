{
  "manifest_version": 3,
  "name": "SonuAI Auto Apply",
  "version": "2.0",
  "description": "AI job auto apply assistant",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": [
    "http://127.0.0.1:5000/*",
    "https://*/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "content.js"
  }
}